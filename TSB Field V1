local order = {0, 0, 0, 0}
local function nextOrder(tab)
    order[tab] += 1
    return order[tab]
end

local function makeToggle(tab, label, get, set)
    local row = mk("TextButton", {
        Size = UDim2.new(1, -8, 0, 34),
        BackgroundColor3 = Color3.fromRGB(33,33,41),
        Text = "",
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(tab),
    }, pages[tab])
    round(row, 6)

    mk("TextLabel", {
        Size = UDim2.new(1, -52, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Color3.fromRGB(220,220,230),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham,
        TextSize = 12,
    }, row)

    local pill = mk("Frame", {
        Size = UDim2.new(0, 32, 0, 16),
        Position = UDim2.new(1, -40, 0.5, -8),
        BackgroundColor3 = get() and Color3.fromRGB(80,255,120) or Color3.fromRGB(60,60,72),
        BorderSizePixel = 0,
    }, row)
    round(pill, 8)

    local knob = mk("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = get() and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
    }, pill)
    round(knob, 6)

    local tw = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
    row.MouseButton1Click:Connect(function()
        local v = not get()
        set(v)
        TweenService:Create(pill, tw, {
            BackgroundColor3 = v and Color3.fromRGB(80,255,120) or Color3.fromRGB(60,60,72),
        }):Play()
        TweenService:Create(knob, tw, {
            Position = v and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6),
        }):Play()
    end)
end

local function makeSlider(tab, label, min, max, get, set)
    local row = mk("Frame", {
        Size = UDim2.new(1, -8, 0, 46),
        BackgroundColor3 = Color3.fromRGB(33,33,41),
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(tab),
    }, pages[tab])
    round(row, 6)

    mk("TextLabel", {
        Size = UDim2.new(1, -56, 0, 20),
        Position = UDim2.new(0, 10, 0, 4),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Color3.fromRGB(220,220,230),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham,
        TextSize = 12,
    }, row)

    local val = mk("TextLabel", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -48, 0, 4),
        BackgroundTransparency = 1,
        Text = tostring(get()),
        TextColor3 = Color3.fromRGB(120,200,255),
        TextXAlignment = Enum.TextXAlignment.Right,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
    }, row)

    local track = mk("TextButton", {
        Size = UDim2.new(1, -20, 0, 8),
        Position = UDim2.new(0, 10, 1, -18),
        BackgroundColor3 = Color3.fromRGB(60,60,72),
        Text = "",
        BorderSizePixel = 0,
    }, row)
    round(track, 4)

    local fill = mk("Frame", {
        Size = UDim2.new((get()-min)/(max-min), 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(50,140,255),
        BorderSizePixel = 0,
    }, track)
    round(fill, 4)

    local dragging = false
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + rel*(max-min) + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        val.Text = tostring(v)
        set(v)
    end
    track.MouseButton1Down:Connect(function(x)
        dragging = true
        update(x)
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            update(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement then dragging = false end
    end)
end

