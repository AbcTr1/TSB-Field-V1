-- SPEED
local speedConn = nil
local function applySpeedLoop()
    if speedConn then speedConn:Disconnect(); speedConn = nil end
    if not S.SpeedOn then
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = BASE_WALK end
        end
        return
    end
    speedConn = RunService.Heartbeat:Connect(function()
        local c = LocalPlayer.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= S.SpeedVal then
            hum.WalkSpeed = S.SpeedVal
        end
    end)
end

-- FLY
local flyBody, flyGyro = nil, nil
local function setFly(on)
    S.Fly = on
    if flyBody then flyBody:Destroy(); flyBody = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
    if not on then return end
    local _, hrp = alive(LocalPlayer)
    if not hrp then S.Fly = false; return end
    flyBody = Instance.new("BodyVelocity")
    flyBody.MaxForce = Vector3.one * 1e5
    flyBody.Velocity = Vector3.zero
    flyBody.Parent = hrp
    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.one * 1e5
    flyGyro.P = 1e4
    flyGyro.Parent = hrp
end

RunService.RenderStepped:Connect(function()
    if not S.Fly or not flyBody or not flyGyro then return end
    local _, hrp = alive(LocalPlayer)
    if not hrp then setFly(false); return end
    flyGyro.CFrame = Camera.CFrame
    local cf = Camera.CFrame
    local dir = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
    local spd = S.FlySpeed * (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 2.2 or 1)
    flyBody.Velocity = (dir.Magnitude > 0) and dir.Unit * spd or Vector3.zero
end)

-- NO COOLDOWN + ANTI KICK
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if S.AntiKick and method == "FireServer" then
        local n = self.Name:lower()
        if n:find("kick") or n:find("ban") or n:find("punish") or n:find("teleporthome") then
            return nil
        end
    end
    return oldNamecall(self, ...)
end)

RunService.Heartbeat:Connect(function()
    local c = LocalPlayer.Character
    if not c then return end
    if S.AntiKick then
        local hum = c:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then
            hum.Health = hum.MaxHealth
        end
    end
    local clears = {}
    if S.NoCDWalk then
        clears[#clears+1] = "WalkSlowdown"; clears[#clears+1] = "Slowed"
        clears[#clears+1] = "NoWalk";       clears[#clears+1] = "Stun"
    end
    if S.NoCDDash then
        clears[#clears+1] = "DashCooldown"; clears[#clears+1] = "DashCD"
        clears[#clears+1] = "LastDash"
    end
    if S.NoCDM1 then
        clears[#clears+1] = "AttackCooldown"; clears[#clears+1] = "M1Cooldown"
        clears[#clears+1] = "ComboCooldown";  clears[#clears+1] = "LastAttack"
    end
    for _, attr in clears do
        if c:GetAttribute(attr) ~= nil then c:SetAttribute(attr, nil) end
    end
end)

-- AUTO PARRY
local function bindParry(char)
    char.AttributeChanged:Connect(function(attr)
        if not S.AutoParry then return end
        if attr ~= "Attacking" and attr ~= "Windup" and attr ~= "HeavyAttack" then return end
        if char:GetAttribute(attr) ~= true then return end
        local _, myHRP = alive(LocalPlayer)
        local root = char:FindFirstChild("HumanoidRootPart")
        if not myHRP or not root then return end
        if (root.Position - myHRP.Position).Magnitude <= 14 then
            keypress(0x46)
            task.delay(0.06, function() keyrelease(0x46) end)
        end
    end)
end
LocalPlayer.CharacterAdded:Connect(function(c) task.wait(1); bindParry(c) end)
if LocalPlayer.Character then bindParry(LocalPlayer.Character) end

-- HITBOX
local origSize = {}
local function setHitbox(on)
    S.Hitbox = on
    for _, p in Players:GetPlayers() do
        if not enemy(p) or not p.Character then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if hrp and hum then
            if on then
                if not origSize[hum] then origSize[hum] = hrp.Size end
                hrp.Size = origSize[hum] * S.HitboxMul
                hrp.Transparency = 0.75
            elseif origSize[hum] then
                hrp.Size = origSize[hum]
                hrp.Transparency = 1
                origSize[hum] = nil
            end
        end
    end
end

-- ESP
local espRefs = {}
local function makeESP(p)
    if espRefs[p] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "FieldESP"
    hl.FillColor = ESPColor
    hl.OutlineColor = Color3.new(1,1,1)
    hl.FillTransparency = 0.75
    hl.OutlineTransparency = 0.2
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = S.ESP and enemy(p)

    local bb = Instance.new("BillboardGui")
    bb.Name = "FieldESP_Name"
    bb.Size = UDim2.new(0, 120, 0, 26)
    bb.AlwaysOnTop = true
    bb.Enabled = S.ESP and enemy(p)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1,0,1,0)
    l.BackgroundTransparency = 1
    l.Text = p.DisplayName
    l.TextColor3 = ESPColor
    l.TextStrokeTransparency = 0.4
    l.Font = Enum.Font.GothamBold
    l.TextSize = 13
    l.Parent = bb

    espRefs[p] = {hl=hl, bb=bb}
    local function attach(char)
        task.wait(0.25)
        hl.Parent = char
        bb.Adornee = char:FindFirstChild("Head")
        bb.Parent = char
    end
    p.CharacterAdded:Connect(attach)
    if p.Character then attach(p.Character) end
end

local function refreshESP()
    for p, r in espRefs do
        local on = S.ESP and enemy(p)
        r.hl.Enabled = on
        r.bb.Enabled = on
    end
end

for _, p in Players:GetPlayers() do
    if p ~= LocalPlayer then makeESP(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then makeESP(p) end
end)
Players.PlayerRemoving:Connect(function(p)
    local r = espRefs[p]
    if r then r.hl:Destroy(); r.bb:Destroy(); espRefs[p] = nil end
end)

-- NOCLIP
RunService.Stepped:Connect(function()
    if not S.Noclip or not LocalPlayer.Character then return end
    for _, part in LocalPlayer.Character:GetDescendants() do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end)

