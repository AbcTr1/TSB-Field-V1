    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -46, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.Parent = row

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0, 40, 0, 20)
    val.Position = UDim2.new(1, -48, 0, 4)
    val.BackgroundTransparency = 1
    val.Text = tostring(get())
    val.TextColor3 = Color3.fromRGB(120, 200, 255)
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Font = Enum.Font.GothamBold
    val.TextSize = 12
    val.Parent = row

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, -20, 0, 8)
    track.Position = UDim2.new(0, 10, 1, -18)
    track.BackgroundColor3 = Color3.fromRGB(60, 60, 72)
    track.Text = ""
    track.BorderSizePixel = 0
    track.Parent = row
    round(track, 4)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((get() - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(50, 140, 255)
    fill.BorderSizePixel = 0
    fill.Parent = track
    round(fill, 4)

    local dragging = false
    local function update(x: number)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + rel * (max - min) + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        val.Text = tostring(v)
        set(v)
    end

    track.MouseButton1Down:Connect(function(x)
        dragging = true; update(x)
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragging = false end
    end)

    rowY[tab] = y + 52
end

