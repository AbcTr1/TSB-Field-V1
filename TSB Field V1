local function notify(msg)
    pcall(function()
        StarterGui:SetCore("SendNotification", {Title="TSB Field V1", Text=msg, Duration=3})
    end)
end

local function alive(p)
    local c = p.Character
    if not c then return nil, nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return nil, nil end
    return c, hrp
end

local function enemy(p)
    if p == LocalPlayer then return false end
    local mt = LocalPlayer.Team
    if mt and p.Team and p.Team == mt then return false end
    return true
end

