    minimized = not minimized
    local targetH = minimized and 42 or 420
    TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
        Size = UDim2.new(0, 340, 0, targetH),
    }):Play()
    minBtn.Text = minimized and "+" or "–"
